# ---- App ----
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ---- Database (Prisma + Postgres) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/powergridbd?schema=public"

# ---- JWT ----
JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ---- Password hashing ----
BCRYPT_SALT_ROUNDS=10

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ---- Auto-seeded accounts (created at server start) ----
TESTER_ADMIN_NAME=Tester Admin
TESTER_ADMIN_EMAIL=testeradmin@powergridbd.com
TESTER_ADMIN_PASSWORD=Tester@12345

# ---- Redis (OTP cache - optional) ----
REDIS_USER=default
REDIS_PASSWORD=
REDIS_HOST=
REDIS_PORT=6379

# ---- SMTP (Gmail app password) ----
EMAIL_SENDER=PowerGridBD <your@email.com>
SMTP_USER=your@email.com
SMTP_PASSWORD=your_gmail_app_password

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
