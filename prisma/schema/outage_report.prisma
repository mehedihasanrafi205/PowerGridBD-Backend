model OutageReport {
  id          String       @id @default(uuid())
  description String
  status      OutageStatus @default(PENDING)
  isPriority  Boolean      @default(false)
  reportedAt  DateTime     @default(now())
  resolvedAt  DateTime?

  customerId String
  customer   User   @relation("CustomerReports", fields: [customerId], references: [id], onDelete: Cascade)

  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  technicianId String?
  technician   User?   @relation("AssignedTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  assignedAt   DateTime?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, reportedAt])
  @@index([customerId])
  @@index([areaId])
  @@index([technicianId])
  @@map("outage_reports")
}
