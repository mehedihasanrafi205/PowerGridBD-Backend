model Area {
  id            String         @id @default(uuid())
  name          String
  feederId      String
  feeder        Feeder         @relation(fields: [feederId], references: [id], onDelete: Cascade)
  users         User[]
  outageReports OutageReport[]
  schedules     Schedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, feederId])
  @@index([feederId])
  @@map("areas")
}
