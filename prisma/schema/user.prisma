model User {
  id    String @id @default(uuid())
  name  String
  email String

  googleId      String?      @unique
  authProvider  AuthProvider @default(CREDENTIAL)
  emailVerified Boolean      @default(false)

  password String?

  needPasswordChange Boolean    @default(false)
  role               UserRole   @default(CUSTOMER)
  status             UserStatus @default(ACTIVE)
  phone              String?
  address            String?

  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  createdSchedules Schedule[] @relation("ScheduleCreator")

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  imageUrl      String @default("")
  imagePublicId String @default("")

  slaActive     Boolean   @default(false)
  slaExpiryDate DateTime?
  slaWarningSentAt DateTime?

  // Relations
  outageReports OutageReport[] @relation("CustomerReports")
  assignedTasks OutageReport[] @relation("AssignedTechnician")
  payments      Payment[]
  auditLogs     AuditLog[]
  technicianApplication TechnicianApplication?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email])
  @@index([role, status])
  @@map("users")
}
