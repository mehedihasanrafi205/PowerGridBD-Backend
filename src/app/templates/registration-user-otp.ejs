<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Email Verification - PowerGridBD</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #0f172a;
      color: #cbd5e1;
      margin: 0;
      padding: 0;
    }
    .email-container {
      max-width: 600px;
      margin: 40px auto;
      background: #1e293b;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
      border: 1px solid #334155;
    }
    .email-header {
      background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
      padding: 30px;
      text-align: center;
      color: #ffffff;
    }
    .email-header h1 {
      margin: 0;
      font-size: 24px;
      font-weight: 700;
      letter-spacing: 0.5px;
    }
    .email-body {
      padding: 35px 30px;
    }
    .welcome-text {
      font-size: 18px;
      color: #f8fafc;
      margin-bottom: 20px;
    }
    .description {
      font-size: 15px;
      line-height: 1.6;
      color: #94a3b8;
      margin-bottom: 30px;
    }
    .otp-box {
      background: #0f172a;
      border: 2px dashed #0ea5e9;
      border-radius: 8px;
      padding: 20px;
      text-align: center;
      margin-bottom: 30px;
    }
    .otp-code {
      font-size: 36px;
      font-weight: 800;
      letter-spacing: 8px;
      color: #38bdf8;
      margin: 0;
    }
    .expiry-note {
      font-size: 13px;
      color: #64748b;
      text-align: center;
      margin-top: 10px;
    }
    .email-footer {
      background: #0f172a;
      padding: 20px;
      text-align: center;
      font-size: 12px;
      color: #64748b;
      border-top: 1px solid #334155;
    }
  </style>
</head>
<body>
  <div class="email-container">
    <div class="email-header">
      <h1>⚡ PowerGridBD</h1>
    </div>
    <div class="email-body">
      <p class="welcome-text">Hello, <strong><%= name || 'Valued User' %></strong>!</p>
      <p class="description">
        Thank you for registering with PowerGridBD. To complete your account verification and access our system, please use the One-Time Password (OTP) below:
      </p>
      
      <div class="otp-box">
        <p class="otp-code"><%= otp %></p>
      </div>

      <p class="expiry-note">This OTP is valid for <strong><%= expirationMinutes || 15 %> minutes</strong>. Do not share this code with anyone.</p>
    </div>
    <div class="email-footer">
      <p>&copy; <%= new Date().getFullYear() %> PowerGridBD. All rights reserved.</p>
      <p>Load Shedding & Power Outage Management System, Bangladesh.</p>
    </div>
  </div>
</body>
</html>