{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2023",
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["node"],
        "ignoreDeprecations": "5.0"
    },
    "include": ["src/**/*", "prisma.config.ts"],
    "exclude": ["node_modules", "dist"]
}