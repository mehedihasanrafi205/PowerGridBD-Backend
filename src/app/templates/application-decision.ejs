<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Application Update - PowerGridBD</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #0f172a;
      color: #cbd5e1;
      margin: 0;
      padding: 0;
    }
    .email-container {
      max-width: 600px;
      margin: 40px auto;
      background: #1e293b;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
      border: 1px solid #334155;
    }
    .email-header {
      background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
      padding: 30px;
      text-align: center;
      color: #ffffff;
    }
    .email-header h1 {
      margin: 0;
      font-size: 24px;
      font-weight: 700;
      letter-spacing: 0.5px;
    }
    .email-body {
      padding: 35px 30px;
    }
    .welcome-text {
      font-size: 18px;
      color: #f8fafc;
      margin-bottom: 20px;
    }
    .description {
      font-size: 15px;
      line-height: 1.6;
      color: #94a3b8;
      margin-bottom: 20px;
    }
    .info-box {
      background: #0f172a;
      border: 1px solid #334155;
      border-radius: 8px;
      padding: 20px;
      margin-bottom: 20px;
      font-size: 15px;
      line-height: 1.6;
      color: #cbd5e1;
    }
    .credential {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 2px;
      color: #38bdf8;
    }
    .email-footer {
      background: #0f172a;
      padding: 20px;
      text-align: center;
      font-size: 12px;
      color: #64748b;
      border-top: 1px solid #334155;
    }
  </style>
</head>
<body>
  <div class="email-container">
    <div class="email-header">
      <h1>⚡ PowerGridBD</h1>
    </div>
    <div class="email-body">
      <p class="welcome-text">Hello, <strong><%= name || 'Valued Applicant' %></strong>!</p>
      <% if (approved) { %>
        <p class="description">
          Congratulations! Your technician application has been <strong>approved</strong>. A technician account has been created for you.
        </p>
        <div class="info-box">
          <p style="margin: 0 0 10px;">Your temporary password:</p>
          <p class="credential" style="margin: 0;"><%= tempPassword %></p>
          <p style="margin: 10px 0 0; font-size: 13px; color: #64748b;">Please log in and change your password immediately.</p>
        </div>
      <% } else { %>
        <p class="description">
          Thank you for your interest in joining PowerGridBD as a field technician. After review, your application was <strong>not approved</strong> at this time.
        </p>
        <div class="info-box">
          <p style="margin: 0;"><strong>Reason:</strong> <%= rejectionReason %></p>
        </div>
      <% } %>
    </div>
    <div class="email-footer">
      <p>&copy; <%= year || new Date().getFullYear() %> PowerGridBD. All rights reserved.</p>
      <p>Load Shedding & Power Outage Management System, Bangladesh.</p>
    </div>
  </div>
</body>
</html>
