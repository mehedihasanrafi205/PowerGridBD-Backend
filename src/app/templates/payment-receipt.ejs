<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Payment Receipt - PowerGridBD</title>
  <style>
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #0f172a; color: #cbd5e1; margin: 0; padding: 0; }
    .email-container { max-width: 600px; margin: 40px auto; background: #1e293b; border-radius: 12px; overflow: hidden; border: 1px solid #334155; }
    .email-header { background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); padding: 30px; text-align: center; color: #ffffff; }
    .email-header h1 { margin: 0; font-size: 24px; font-weight: 700; }
    .email-body { padding: 35px 30px; }
    .welcome-text { font-size: 18px; color: #f8fafc; margin-bottom: 20px; }
    .description { font-size: 15px; line-height: 1.6; color: #94a3b8; margin-bottom: 20px; }
    .info-box { background: #0f172a; border: 1px solid #334155; border-radius: 8px; padding: 20px; margin-bottom: 20px; font-size: 15px; color: #cbd5e1; }
    .amount { font-size: 24px; font-weight: 800; color: #38bdf8; }
    .email-footer { background: #0f172a; padding: 20px; text-align: center; font-size: 12px; color: #64748b; border-top: 1px solid #334155; }
  </style>
</head>
<body>
  <div class="email-container">
    <div class="email-header"><h1>⚡ PowerGridBD</h1></div>
    <div class="email-body">
      <p class="welcome-text">Hello, <strong><%= name || 'Valued Customer' %></strong>!</p>
      <% if (success) { %>
        <p class="description">Your payment was <strong>successful</strong>. Here is your receipt:</p>
      <% } else { %>
        <p class="description">Your payment could <strong>not be completed</strong>. No amount was charged for this attempt. Details:</p>
      <% } %>
      <div class="info-box">
        <p class="amount" style="margin: 0 0 12px;">BDT <%= amount %></p>
        <p style="margin: 0 0 8px;"><strong>Transaction ID:</strong> <%= transactionId %></p>
        <p style="margin: 0 0 8px;"><strong>Purpose:</strong> <%= purpose %></p>
        <p style="margin: 0;"><strong>Status:</strong> <%= success ? 'COMPLETED' : 'FAILED' %></p>
      </div>
      <% if (success) { %>
        <p class="description">Thank you for using PowerGridBD.</p>
      <% } else { %>
        <p class="description">Please try again or contact support if the problem persists.</p>
      <% } %>
    </div>
    <div class="email-footer">
      <p>&copy; <%= year || new Date().getFullYear() %> PowerGridBD. All rights reserved.</p>
      <p>Load Shedding & Power Outage Management System, Bangladesh.</p>
    </div>
  </div>
</body>
</html>
