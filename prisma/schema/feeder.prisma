model Feeder {
  id           String     @id @default(uuid())
  name         String 
  substationId String
  substation   Substation @relation(fields: [substationId], references: [id], onDelete: Cascade)
  areas        Area[]
  schedules    Schedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, substationId])
  @@index([substationId])
  @@map("feeders")
}
